# Build output
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Generated reports. The tool writes HTML next to the recording, and those pages embed
# thread names and stack traces from whatever was profiled - never commit them.
*.html
!src/main/resources/**/*.html

# Logs and JVM crash dumps
*.log
hs_err_pid*
replay_pid*

# IDE / editor / tooling
*.iml
.idea/
*.ctxt
.mtj.tmp/
.claude/

# OS
.DS_Store
